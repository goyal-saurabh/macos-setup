{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "mcp": {
    "context7": {"type":"local","command":["pnpm","dlx","@upstash/context7-mcp"],"environment":{"CONTEXT7_API_KEY":"${CONTEXT7_API_KEY:-}"}},
    "mempalace": {"type":"remote","url":"http://127.0.0.1:8765/mcp"}
  },
  "model": "opencode/nemotron-3-ultra-free",
  "permission": {
    "apply_patch": "allow",
    "bash": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "question": "allow",
    "read": "allow",
    "skill": {
      "*": "allow"
    },
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "write": "allow"
  },
  "plugin": [
    "@warp-dot-dev/opencode-warp"
  ],
  "server": {
    "port": 4096
  },
  "watcher": {},
  "lsp": {
    "typescript": {
      "command": [
        "mise",
        "x",
        "--",
        "pnpm",
        "--package=typescript",
        "--package=typescript-language-server",
        "dlx",
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".cjs",
        ".cts",
        ".js",
        ".jsx",
        ".mjs",
        ".mts",
        ".ts",
        ".tsx"
      ]
    }
  }
}
